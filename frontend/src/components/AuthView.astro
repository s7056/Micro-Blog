---
import "../styles/form.css";
import LoginForm from "./LoginForm.astro";
import LogoutButton from "./LogoutButton.astro";

const API = import.meta.env.API;
const cookieName = import.meta.env.COOKIE_NAME || "_MicroBlog_Security_Login_";
const token = Astro.cookies.get(cookieName)?.value;

let logged = false;
let userName = "";
let posts = [];

if (token) {
  try {
    const userRes = await fetch(`${API}/api/users/me`, {
      headers: { Authorization: `Bearer ${token}` },
    });

    if (userRes.ok) {
      const user = await userRes.json();
      userName = user.name || user.login || "Użytkowniku";
      logged = true;
    }

    const postsRes = await fetch(`${API}/api/posts`, {
      headers: { Authorization: `Bearer ${token}` },
    });

    if (postsRes.ok) {
      posts = await postsRes.json();
    }
  } catch (e) {
    console.error(e);
    logged = false;
  }
}

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString("pl-PL", {
    weekday: "short",
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}
---

<div class="relative max-w-5xl mx-auto p-6">
  {logged ? (
    <>
      <div class="absolute top-4 right-4 flex items-center space-x-4">
        <a href="/profile" class="font-semibold text-blue-500 hover:underline">
          Witaj, {userName} 👋
        </a>
        <LogoutButton />
      </div>

      <h1 class="text-3xl font-bold text-center mb-6">Micro Blog</h1>

      {/* Grid postów */}
      {posts.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map(post => (
            <div
              key={post.id}
              class="bg-white rounded-lg shadow-md p-4 border border-gray-200 hover:shadow-lg transition"
            >
              <div class="text-sm text-gray-500 mb-2">
                {formatDate(post.createdAt)} • <span class="font-semibold">{post.authorName}</span>
              </div>
              <p class="text-gray-800">{post.content}</p>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-center text-gray-500 mt-6">Brak postów do wyświetlenia...</p>
      )}
    </>
  ) : (
    <>
      <h1 class="text-3xl font-bold text-center mb-6">Micro Blog</h1>
      <LoginForm client:load />
      <div class="mt-4 text-center text-sm">
        <a href="/register" class="text-blue-500 hover:underline">
          Nie masz konta? Zarejestruj się
        </a>
      </div>
    </>
  )}
</div>