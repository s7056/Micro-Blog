---
import "../styles/form.css";
import Layout from "../layouts/Layout.astro";
import RegisterForm from "../components/RegisterForm.astro";

const errorMessage = Astro.cookies.get("registerError")?.value;

if (errorMessage) {
  Astro.cookies.delete("registerError", { path: "/register" });
}
---

<Layout page="Register">
  <div class="w-full max-w-md p-8 bg-white rounded shadow-md">
    {errorMessage && (
      <div class="error-message text-red-500 mb-4 text-center">
        {errorMessage}
      </div>
    )}
    <div class="register">
      <h1 class="text-3xl font-bold text-center mb-6">Rejestracja</h1>
      <RegisterForm client:load />
    </div>
  </div>
</Layout>